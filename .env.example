# Disposable local development values. Never reuse in a deployment.
POSTGRES_DB=servicepulse
POSTGRES_USER=servicepulse
POSTGRES_PASSWORD=local-development-only
# This exception is for the named Compose simulator ONLY. Empty is the safe default.
SIMULATOR_ORIGIN=http://simulator:8090
# Local catcher only; no real SMTP credentials or external provider required.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SENDER=servicepulse@example.com
SMTP_TIMEOUT_SECONDS=5
